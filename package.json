{
  "name": "rl-journal",
  "productName": "RL Journal",
  "version": "1.10.1",
  "description": "Rocket League training & games journal with season tracking, statistics and automatic game logging.",
  "author": "RL Journal",
  "license": "MIT",
  "homepage": "https://github.com/GAGBI123/rl-journal",
  "repository": {
    "type": "git",
    "url": "https://github.com/GAGBI123/rl-journal.git"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "desktopName": "rl-journal.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "electron .",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.rljournal.app",
    "productName": "RL Journal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RL Journal",
      "artifactName": "RL-Journal-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GAGBI123",
        "repo": "rl-journal",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "rl-journal",
      "synopsis": "Rocket League training & games journal",
      "maintainer": "RL Journal",
      "artifactName": "RL-Journal-x86_64.${ext}",
      "desktop": {
        "entry": {
          "Name": "RL Journal",
          "StartupWMClass": "RL Journal"
        }
      }
    },
    "appImage": {
      "artifactName": "RL-Journal-x86_64.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
